# Copie para .env.local (desenvolvimento) e configure as mesmas variáveis
# em Vercel > Settings > Environment Variables (produção e pré-visualização).
# NUNCA versione valores reais.

# Supabase > Project Settings > API. Podem ir ao navegador.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Chave secreta (sb_secret_...). SOMENTE servidor: sem prefixo NEXT_PUBLIC.
# Lida apenas por src/lib/supabase/admin.ts (convite, suspensão, exclusão).
SUPABASE_SECRET_KEY=
